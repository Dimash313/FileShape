BOT_TOKEN=replace_with_your_bot_token
# Set these only after your HTTPS Mini App is actually hosted:
# MINIAPP_URL=https://your-real-domain.example
# MINIAPP_ORIGIN=https://your-real-domain.example

# Local API metadata directory (0700, service-owned). Compose uses /app/state.
# FILESHAPE_STATE_DIR=./state

# Standalone bot only: set the URL to the trusted internal API endpoint to enforce
# required-channel access in Telegram bot conversions. Compose sets this itself.
# FILESHAPE_ACCESS_GATE_URL=http://127.0.0.1:8000/internal/v1/access/check

# Owner-only advertising campaign API. Set to your numeric Telegram user ID.
# Without this value, all owner campaign endpoints fail closed (503).
# FILESHAPE_OWNER_ID=123456789

# Standalone bot only: internal authenticated campaign join bridge.
# Compose sets this itself. Never expose the internal endpoint publicly.
# FILESHAPE_CAMPAIGN_JOIN_URL=http://127.0.0.1:8000/internal/v1/campaigns/join

# 4.24 Stars purchase safety gate: disabled by default.
# DO NOT enable outside Telegram's dedicated payment test environment until
# real successful_payment/reversal tests, buyer support, and release audit pass.
# Both the bot and API require a configured support username to enable checkout.
FILESHAPE_STARS_CHECKOUT_ENABLED=false
# FILESHAPE_SUPPORT_USERNAME=YourSupportAccount
# Standalone bot only; Compose derives the trusted Stars API from the access URL.
# FILESHAPE_STARS_GATE_URL=http://127.0.0.1:8000/internal/v1/stars
